---
import '~/styles/global.scss';
import SEO from '~/components/SEO.astro';
import Scanlines from '~/components/effects/Scanlines.astro';

interface Article {
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: Article;
}

const {
  title,
  description = 'Portafolio digital de Amilkar Dominguez — desarrollador de software.',
  ogImage = '/og-default.png',
  article,
} = Astro.props;

const siteURL = Astro.site ?? new URL('https://amilkardominguez.com');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImageURL = new URL(ogImage, siteURL).toString();
const fullTitle =
  title === 'Inicio' ? 'Amilkar Dominguez' : `${title} | Amilkar Dominguez`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fuente principal — preload para evitar FOUT en la primera carga -->
    <link
      rel="preload"
      href="/fonts/ubuntu-mono-latin-400-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <SEO
      title={fullTitle}
      description={description}
      canonical={canonicalURL.toString()}
      ogImage={ogImageURL}
      article={article}
    />

    <slot name="head" />
  </head>
  <body>
    <Scanlines />
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <slot />
  </body>
</html>
