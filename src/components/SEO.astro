---
interface Article {
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

interface Props {
  title: string;       // Título ya compuesto ("Inicio | Amilkar Dominguez")
  description: string;
  canonical: string;
  ogImage: string;     // URL absoluta
  article?: Article;   // Presente solo en posts de blog
}

const { title, description, canonical, ogImage, article } = Astro.props;

const structuredData = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: article.pubDate.toISOString(),
      ...(article.updatedDate && {
        dateModified: article.updatedDate.toISOString(),
      }),
      author: {
        '@type': 'Person',
        name: 'Amilkar Dominguez',
        url: 'https://amilkardominguez.com',
      },
      url: canonical,
      image: ogImage,
      ...(article.tags && article.tags.length > 0 && {
        keywords: article.tags.join(', '),
      }),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Amilkar Dominguez',
      url: 'https://amilkardominguez.com',
      jobTitle: 'Desarrollador de software',
      sameAs: [
        'https://github.com/amilkardominguez',
        'https://linkedin.com/in/amilkardominguez',
      ],
    };
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content="es_ES" />
<meta property="og:site_name" content="Amilkar Dominguez" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Artículo: fechas para Open Graph -->
{article && (
  <meta property="article:published_time" content={article.pubDate.toISOString()} />
)}
{article?.updatedDate && (
  <meta property="article:modified_time" content={article.updatedDate.toISOString()} />
)}

<!-- JSON-LD — set:html evita el encoding de entidades HTML dentro del script -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
