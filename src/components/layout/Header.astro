---
const navLinks = [
  { href: '/',          label: 'Inicio'     },
  { href: '/proyectos', label: 'Proyectos'  },
  { href: '/blog',      label: 'Blog'       },
  { href: '/sobre-mi',  label: 'Sobre mí'   },
] as const;

const { pathname } = Astro.url;

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header">
  <nav class="nav container" aria-label="Navegación principal">
    <a href="/" class="nav__brand" aria-label="Amilkar Dominguez — inicio">
      <span class="nav__brand-prefix" aria-hidden="true">~/</span>amilkar
    </a>

    <ul class="nav__list" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={['nav__link', { 'nav__link--active': isActive(href) }]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style lang="scss">
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    height: var(--header-height);
    display: flex;
    align-items: center;
    // color-mix necesita baseline 2023+ (Chrome 111, FF 113, Safari 16.2) — OK para portfolio
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .nav__brand {
    font-family: var(--font-mono);
    font-size: var(--font-size-lg);
    font-weight: 700;
    color: var(--color-neon-cyan);
    text-decoration: none;
    letter-spacing: -0.02em;
    transition: color var(--transition-fast);

    &:hover,
    &:focus-visible {
      color: var(--color-text);
      text-decoration: none;
    }
  }

  .nav__brand-prefix {
    color: var(--color-neon-green);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .nav__link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    border-radius: var(--radius-md);
    transition:
      color var(--transition-fast),
      background-color var(--transition-fast);

    &:hover,
    &:focus-visible {
      color: var(--color-neon-cyan);
      background-color: color-mix(in srgb, var(--color-neon-cyan) 8%, transparent);
      text-decoration: none;
    }

    &--active {
      color: var(--color-neon-cyan);
    }
  }

  // Mobile: reduce padding, mantiene legibilidad
  @media (max-width: 480px) {
    .nav__brand {
      font-size: var(--font-size-base);
    }

    .nav__link {
      padding: var(--space-2) var(--space-2);
      font-size: var(--font-size-xs);
    }
  }
</style>
