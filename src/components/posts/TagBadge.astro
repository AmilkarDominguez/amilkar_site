---
interface Props {
  tag: string;
  href?: string;
}

const { tag, href } = Astro.props;
---

{
  href ? (
    <a href={href} class="tag-badge">
      {tag}
    </a>
  ) : (
    <span class="tag-badge">{tag}</span>
  )
}

<style lang="scss">
  .tag-badge {
    display: inline-block;
    padding: var(--space-1) var(--space-2);
    background-color: color-mix(in srgb, var(--color-neon-cyan) 10%, transparent);
    color: var(--color-neon-cyan);
    border: 1px solid color-mix(in srgb, var(--color-neon-cyan) 25%, transparent);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);

    &:is(a):hover,
    &:is(a):focus-visible {
      background-color: color-mix(in srgb, var(--color-neon-cyan) 20%, transparent);
      border-color: var(--color-neon-cyan);
      text-decoration: none;
    }
  }
</style>
