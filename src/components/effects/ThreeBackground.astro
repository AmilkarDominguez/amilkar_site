---
// Fondo Three.js global, montado una sola vez en BaseLayout.
// Puramente decorativo: aria-hidden, pointer-events: none, detrás de todo el contenido.
// La lógica de la escena vive en ~/lib/three/backgroundScene.ts (ver .claude/rules-threejs.md).
---

<canvas class="three-bg" aria-hidden="true"></canvas>

<style lang="scss">
  .three-bg {
    position: fixed;
    inset: 0;
    z-index: var(--z-behind);
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;

    @media (prefers-reduced-motion: reduce) {
      display: none;
    }
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.three-bg');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (canvas && !prefersReducedMotion) {
    const start = async () => {
      const { createBackgroundScene } = await import('~/lib/three/backgroundScene');
      const scene = createBackgroundScene(canvas);

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          scene.pause();
        } else {
          scene.resume();
        }
      });

      window.addEventListener('pagehide', () => scene.dispose(), { once: true });
    };

    if (typeof window.requestIdleCallback === 'function') {
      window.requestIdleCallback(() => void start());
    } else {
      setTimeout(() => void start(), 200);
    }
  }
</script>
