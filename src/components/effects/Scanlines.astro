---
// Sin props. El overlay siempre está en el DOM; CSS desactiva todo con reduced-motion.
// pointer-events: none garantiza que nunca bloquea clicks ni teclado.
---

<div class="scanlines" aria-hidden="true"></div>

<style lang="scss">
  .scanlines {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: var(--z-overlay);

    // Gradiente de líneas horizontales muy sutiles — scanlines del CRT
    background-image: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.04) 2px,
      rgba(0, 0, 0, 0.04) 4px
    );

    // CRT flicker: opacidad oscila muy levemente en un ciclo largo (8s)
    animation: crt-flicker 8s ease-in-out infinite;
    opacity: 1;

    // Reducción de movimiento: elimina completamente el componente visualmente.
    // No solo pausa la animación, sino que lo oculta, respetando la preferencia.
    @media (prefers-reduced-motion: reduce) {
      display: none;
    }
  }
</style>
